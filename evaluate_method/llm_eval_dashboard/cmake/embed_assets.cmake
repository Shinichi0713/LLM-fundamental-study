# Reads the dashboard assets and turns them into raw string literals.
# Invoked at build time: cmake -DWEB_DIR=... -DOUTPUT=... -P embed_assets.cmake

file(READ "${WEB_DIR}/index.html" INDEX_HTML)
file(READ "${WEB_DIR}/styles.css" STYLES_CSS)
file(READ "${WEB_DIR}/app.js" APP_JS)

get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

file(WRITE "${OUTPUT}" "// Auto-generated by cmake/embed_assets.cmake. Do not edit.\n")
file(APPEND "${OUTPUT}" "#pragma once\n\nnamespace llmbench {\nnamespace embedded {\n\n")
file(APPEND "${OUTPUT}" "inline const char* kIndexHtml = R\"LLMASSET(${INDEX_HTML})LLMASSET\";\n\n")
file(APPEND "${OUTPUT}" "inline const char* kStylesCss = R\"LLMASSET(${STYLES_CSS})LLMASSET\";\n\n")
file(APPEND "${OUTPUT}" "inline const char* kAppJs = R\"LLMASSET(${APP_JS})LLMASSET\";\n\n")
file(APPEND "${OUTPUT}" "} // namespace embedded\n} // namespace llmbench\n")
